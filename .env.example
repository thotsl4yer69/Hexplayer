# HexPlayer v2 environment configuration. Copy to .env; never commit real secrets.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
DEVICE_NAME=HexPlayer
DEVICE_ID=
NFC_SPI_BUS=0
NFC_SPI_DEVICE=0
NFC_RESET_PIN=25
DEBOUNCE_SECONDS=3
POLL_INTERVAL=0.2
LOG_LEVEL=INFO

# Android/local control API. Set your own random key; blank disables the API.
HEXPLAYER_API_HOST=0.0.0.0
HEXPLAYER_API_PORT=8787
HEXPLAYER_API_KEY=

# Optional: configure Home Assistant here, or provision it securely from the Android app.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Enable only behind a trusted HTTPS reverse proxy; bind API host to 127.0.0.1 first.
HEXPLAYER_TRUST_PROXY_TLS=false
# DEBOUNCE_SECONDS confirms removal and spaces Spotify retry attempts.
# Held tags fire once; HA actions never retry automatically while held.
